# Copy to .env or run setup.bat. Never commit your real .env.
QBT_URL=http://localhost:8080
QBT_USER=
QBT_PASS=

# Automatic Proton VPN service recovery is enabled by default.
PROTON_AUTO_RECONNECT=true
# Optional: full path to the Proton VPN client executable, for relaunch if closed.
PROTON_APP_PATH=

# When the forwarded port falls in a block reserved by WSL/Docker/Hyper-V NAT, restart winnat to free it.
# Briefly drops WSL/Docker NAT networking. Set to false to only log the collision.
WINNAT_AUTO_RESTART=true
